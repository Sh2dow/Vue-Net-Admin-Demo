{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=vue_demo;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Auth": {
    "Authority": "https://localhost:5201",
    "PostLogoutRedirectUri": "/login"
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672",
    "Exchange": "vue-demo.events",
    "DeadLetterExchange": "vue-demo.events.dlx",
    "PaymentRequestQueue": "payments.stub.requests",
    "OrderSagaQueue": "orders.saga",
    "OrderExecutionQueue": "orders.execution.dispatch",
    "OutboxBatchSize": 20,
    "RetryDelaySeconds": 5
  },
  "Payments": {
    "AutoAuthorize": true,
    "StubDelayMilliseconds": 250
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
