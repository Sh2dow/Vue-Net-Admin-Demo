{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=vue_demo;Username=vue;Password=123"
  },
  "Auth": {
    "Authority": "https://localhost:5201"
  },
  "AuthService": {
    "BaseUrl": "http://localhost:5101"
  },
  "DownstreamServices": {
    "UsersBaseUrl": "http://localhost:5105",
    "TasksBaseUrl": "http://localhost:5102",
    "OrdersBaseUrl": "http://localhost:5103",
    "PaymentsBaseUrl": "http://localhost:5104"
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672",
    "Exchange": "vue-demo.events",
    "DeadLetterExchange": "vue-demo.events.dlx",
    "PaymentRequestQueue": "payments.stub.requests",
    "OrderSagaQueue": "orders.saga",
    "OrderExecutionQueue": "orders.execution.dispatch",
    "OutboxBatchSize": 20,
    "RetryDelaySeconds": 5
  },
  "Payments": {
    "AutoAuthorize": true,
    "StubDelayMilliseconds": 250
  },
  "OrderExecution": {
    "AutoComplete": true,
    "StubDelayMilliseconds": 250
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
